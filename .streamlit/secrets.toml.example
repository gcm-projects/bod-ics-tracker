# ---------------------------------------------------------------------------
# Streamlit secrets TEMPLATE for Microsoft Entra ID authentication.
#
# HOW TO USE
#   Local dev : copy this file to  .streamlit/secrets.toml  and fill in real
#               values. The real secrets.toml is git-ignored — never commit it.
#   Production: DO NOT deploy a secrets.toml. On Streamlit Community Cloud,
#               paste the same keys under  App -> Settings -> Secrets.
#
# Reference: https://docs.streamlit.io/develop/tutorials/authentication/microsoft
# ---------------------------------------------------------------------------

[auth]
# Redirect (callback) URI. It MUST match a "Web" redirect URI registered on the
# Entra ID app registration EXACTLY. Register BOTH of these there:
#   local dev   -> http://localhost:8501/oauth2callback
#   production  -> https://<your-app>.streamlit.io/oauth2callback
# Use the localhost one here for local dev; use the production one in the
# Community Cloud Secrets UI.
redirect_uri = "http://localhost:8501/oauth2callback"

# Strong random string used to sign the identity cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

# From the Entra ID app registration (Azure portal -> App registrations).
client_id = "REPLACE_WITH_APPLICATION_CLIENT_ID"
client_secret = "REPLACE_WITH_CLIENT_SECRET_VALUE"

# Entra ID (work / school accounts). Use YOUR tenant id to restrict sign-in to
# your organisation only. NOTE: the Streamlit docs show a "/consumers/" URL —
# that is for PERSONAL Microsoft accounts; use the tenant form below instead.
#   any org account : .../organizations/v2.0/...
#   your org only    : .../<TENANT_ID>/v2.0/...
server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"
